su - gvm -c "/usr/bin/greenbone-feed-sync --type nvt"
su - gvm -c "/usr/bin/greenbone-feed-sync --type gvmd-data"
su - gvm -c "/usr/bin/greenbone-feed-sync --type scap"
su - gvm -c "/usr/bin/greenbone-feed-sync --type cert"
su - gvm -c "openvas --update-vt-info"

# Cleanup event for /tmp
rm -rf /tmp/gvmd-split-xml-file-* >/dev/null 2>&1
